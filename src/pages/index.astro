  <script>
    // Next-deadline strip: pick the first upcoming date at view time.
    const strip = document.querySelector<HTMLElement>('[data-deadline-strip]');
    if (strip) {
      const list: Array<{ date: string; title: string }> = JSON.parse(strip.dataset.deadlineStrip ?? '[]');
      const today = new Date().toISOString().slice(0, 10);
      const next = list.find((d) => d.date >= today);
      if (next) {
        const days = Math.round((Date.parse(next.date) - Date.parse(today)) / 86_400_000);
        strip.querySelector('[data-strip-date]')!.textContent = new Date(`${next.date}T12:00:00Z`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'UTC' });
        strip.querySelector('[data-strip-title]')!.textContent = next.title;
        strip.querySelector('[data-strip-left]')!.textContent = days === 0 ? 'bugün' : days === 1 ? 'yarın' : `${days} gün kaldı`;
      }
    }

    // Hero question box: hands the query to the site search dialog.
    document.querySelector<HTMLFormElement>('[data-hero-search]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const q = new FormData(event.currentTarget as HTMLFormElement).get('q');
      (window as any).rvOpenSearch?.(String(q ?? ''));
    });
  </script>

