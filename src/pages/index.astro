---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Fact from '../components/Fact.astro';
import { getGuides } from '../data/guides';
import { deadlines, formatDate } from '../data/takvim';
import Illustration from '../components/Illustration.astro';
import {
  type IllustrationName,
  type IllustrationTone,
  personas,
} from '../data/site';

const guideCount = (await getGuides()).length;
const today = new Date().toISOString().slice(0, 10);
const commonDeadlines = deadlines
  .filter((d) => d.audience === 'herkes')
  .map(({ date, title, period }) => ({ date, title, period }));
const nextDeadline = commonDeadlines.find((d) => d.date >= today);


const title = 'Remote Vergi 2026: Yurtdışı Çalışanlar Vergi Hesaplayıcı';
const description =
  'Yurtdışına remote çalışan yazılımcılar için 2026 vergi hesaplama aracı. %100 hizmet ihracatı kazanç istisnası, YMM tasdik raporu ve net kazanç hesaplayıcı.';
const dateModified = '2026-05-07';
---

<Layout
  title={title}
  description={description}
  dateModified={dateModified}
  ogImage="/og/index.png"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Remote Vergi',
      description:
        'Yurtdışına remote çalışan yazılımcılar için 2026 mevzuatına göre vergi hesaplama aracı',
      url: 'https://remotevergi.com/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      author: {
        '@type': 'Person',
        name: 'Ahmet Özışık',
        url: 'https://ahmet.ee',
      },
      isAccessibleForFree: true,
      dateModified,
    })}
    slot="head"
  />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: '%100 hizmet ihracatı kazanç istisnasından nasıl yararlanılır',
      description:
        'Yurt dışı müşterilere hizmet ihracatı yapan Türkiye mukimi mükelleflerin %100 kazanç istisnasından yararlanmak için izlemesi gereken adımlar.',
      totalTime: 'P1D',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Mükellefiyet türünü belirle',
          text: 'Mesleğine göre serbest meslek erbabı (mühendis, mimar, doktor vb.) veya şahıs şirketi (yazılımcı, tasarımcı vb.) olarak vergi mükellefiyeti aç.',
          url: 'https://remotevergi.com/sahis-sirketi/',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Faturayı yurt dışı müşteri adına kes',
          text: "e-Arşiv 302 (11/1-a) muafiyet kodu ile yurt dışındaki müşteri adına döviz cinsinden fatura düzenle.",
          url: 'https://remotevergi.com/302-11-1-a-fatura-ornegi/',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Ödemeyi Türkiye’ye döviz olarak getir',
          text: 'Wise, Payoneer, Revolut veya Deel üzerinden ödemeyi al ve Türkiye’deki banka hesabına döviz olarak transfer et. Beyanname son tarihine kadar tüm kazancın Türkiye’ye getirilmesi şarttır.',
          url: 'https://remotevergi.com/yurtdisindan-odeme-alma/',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Yıllık beyannamede istisnayı uygula',
          text: 'Yıllık gelir vergisi beyannamesinde hizmet ihracatı kazancını %100 oranında istisna olarak göster.',
          url: 'https://remotevergi.com/hizmet-ihracati-istisnasi/',
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Eşik aşılırsa YMM tasdik raporu hazırlat',
          text: 'Yıllık indirim tutarı 500.000 TL’yi veya toplam istisna ve indirimler 1.000.000 TL’yi aşıyorsa, beyannameden itibaren 2 ay içinde Yeminli Mali Müşavir tasdik raporunu vergi dairesine ibraz et.',
          url: 'https://remotevergi.com/hizmet-ihracati-istisnasi/',
        },
      ],
    })}
    slot="head"
  />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Yurtdışına remote çalışırken hangi mükellefiyet türü açılır?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "Mesleğe göre değişir. Mühendis, mimar, doktor, avukat, mali müşavir, sanatçı gibi Vergi Usul Kanunu'nda sayılan meslek mensupları serbest meslek erbabı olarak kayıt yaptırabilir. Yazılımcı, dijital tasarımcı, içerik üreticisi gibi roller şahıs şirketi (ticari kazanç) üzerinden fatura keser. Yurt dışı hizmet ihracatı %100 kazanç istisnası her iki yapı için de geçerlidir.",
          },
        },
        {
          '@type': 'Question',
          name: 'Hizmet ihracatında %100 kazanç istisnası nasıl uygulanıyor?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "30 Nisan 2026 tarihli Resmî Gazete'de yayımlanan 11257 sayılı Cumhurbaşkanı Kararı ile yurt dışına verilen yazılım, mühendislik, mimarlık, tasarım, eğitim ve sağlık hizmetlerinde uygulanan kazanç indirimi oranı %80'den %100'e yükseltilmiştir.",
          },
        },
        {
          '@type': 'Question',
          name: 'YMM tasdik raporu ne zaman zorunlu olur?',
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              "Yıllık hizmet ihracatı indirim tutarı 500.000 TL'yi veya toplam istisna ve indirimler 1.000.000 TL'yi aştığında YMM tasdik raporu zorunludur.",
          },
        },
      ],
    })}
    slot="head"
  />

  <!-- Hero: ask what they need, the NerdWallet way -->
  <section class="hero relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-5 md:px-8 pt-12 md:pt-20 pb-16 md:pb-24 grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
      <div>
        <p class="inline-flex items-center gap-2 h-8 px-3 rounded-full bg-white/80 border border-brand-100 text-[13px] font-semibold text-brand-700">
          <span class="w-1.5 h-1.5 rounded-full bg-gain-600" aria-hidden="true"></span>
          2026 mevzuatına göre güncel
        </p>
        <h1 class="mt-5 text-[clamp(2.4rem,1.5rem+3.6vw,4.1rem)] font-bold leading-[1.02] tracking-[-0.035em] text-slate-900">
          Yurt dışına çalışıyorsun.
          <span class="relative inline-block">
            Vergisi
            <svg class="pen-underline absolute left-0 -bottom-2 w-full h-4 text-brand-500" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true">
              <path d="M3 11c38-6 92-9 194-5" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
            </svg>
          </span>
          karışık olmak zorunda değil.
        </h1>
        <p class="mt-6 max-w-xl text-[18px] leading-relaxed text-slate-700">
          Türkiye'den yabancı şirketlere çalışan yazılımcı, uygulama ve oyun
          geliştiricileri için vergi, şirket ve fatura rehberi. Sade dille,
          kaynağıyla, ücretsiz.
        </p>

        <form class="mt-8 max-w-xl" data-hero-search role="search">
          <label for="hero-q" class="block text-[15px] font-semibold text-slate-900 mb-2">
            Aklındaki soruyu yaz
          </label>
          <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-white border border-slate-200 shadow-[0_8px_30px_-12px_oklch(0.21_0.016_25/0.25)] focus-within:border-brand-400 focus-within:ring-4 focus-within:ring-brand-100 transition">
            <svg viewBox="0 0 24 24" class="w-5 h-5 ml-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path stroke-linecap="round" d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              id="hero-q"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="Örn. Upwork geliri nasıl faturalanır?"
              class="flex-1 min-w-0 h-12 bg-transparent text-[16px] text-slate-900 placeholder:text-slate-500 outline-none"
            />
            <button type="submit" class="h-12 px-5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-[15px] font-semibold transition">
              Sor
            </button>
          </div>
        </form>
        <div class="mt-4 flex flex-wrap gap-2 max-w-xl">
          <span class="text-[14px] text-slate-600 mr-1 self-center">Sık sorulanlar:</span>
          <a href="/sahis-sirketi-maliyet/" class="chip">Bağ-Kur ne kadar?</a>
          <a href="/302-11-1-a-fatura-ornegi/" class="chip">Faturayı nasıl keserim?</a>
          <a href="/sahis-sirketi/" class="chip">Şirket açmalı mıyım?</a>
          <a href="/hizmet-ihracati-istisnasi/" class="chip">%100 istisna kimlere?</a>
        </div>
      </div>

      <!-- Illustrated invoice: what the whole site helps you do -->
      <div class="relative mx-auto w-full max-w-[420px] lg:max-w-none mb-10" aria-hidden="true">
        <div class="invoice relative rounded-3xl bg-white border border-slate-200 p-6 md:p-7 shadow-[0_30px_60px_-30px_oklch(0.21_0.016_25/0.35)] rotate-[-2deg]">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-[12px] font-semibold text-slate-500">e-Arşiv Fatura</p>
              <p class="mt-0.5 text-[17px] font-bold text-slate-900">Acme GmbH, Berlin</p>
            </div>
            <span class="num text-[12px] text-slate-500">#2026-014</span>
          </div>
          <div class="mt-6 space-y-3 text-[14px]">
            <div class="flex justify-between"><span class="text-slate-600">Software Development Service</span><span class="num font-medium text-slate-900">€4.000</span></div>
            <div class="flex justify-between"><span class="text-slate-600">KDV (302 istisna)</span><span class="num font-medium text-slate-900">%0</span></div>
            <div class="h-px bg-slate-200"></div>
            <div class="flex justify-between text-[16px]"><span class="font-semibold text-slate-900">Toplam</span><span class="num font-semibold text-slate-900">€4.000</span></div>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[13px] text-slate-600">
            <span class="inline-flex w-5 h-5 rounded-full bg-gain-100 items-center justify-center">
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-gain-700" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path></svg>
            </span>
            Ödeme Türkiye'deki hesaba geldi
          </div>
        </div>
        <div class="sticker absolute -bottom-16 right-0 md:-right-4 rotate-[4deg] rounded-2xl bg-slate-900 text-white px-5 py-4 shadow-xl">
          <p class="text-[12px] text-slate-300">Bu kazanca gelir vergisi</p>
          <p class="num text-[28px] font-semibold leading-none mt-1 text-gain-100">%0</p>
          <p class="text-[11px] text-slate-400 mt-1">şartlar sağlanırsa</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Next tax deadline, recomputed in the browser so it never goes stale -->
  {
    nextDeadline && (
      <section class="max-w-6xl mx-auto px-5 md:px-8 pt-10">
        <a
          href="/vergi-takvimi/"
          data-deadline-strip={JSON.stringify(commonDeadlines)}
          class="group flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl border border-slate-200 bg-white px-5 py-4 hover:border-slate-300 transition"
        >
          <Illustration name="calendar" tone="rose" class="w-10 h-10 shrink-0" />
          <span class="text-[15px] text-slate-700">
            <span class="font-semibold text-slate-900">Sıradaki son tarih:</span>{' '}
            <span data-strip-date>{formatDate(nextDeadline.date)}</span>,{' '}
            <span data-strip-title>{nextDeadline.title}</span>
          </span>
          <span class="inline-flex items-center h-7 px-2.5 rounded-full bg-brand-50 text-[13px] font-semibold text-brand-700" data-strip-left></span>
          <span class="ml-auto text-[14px] font-semibold text-brand-700 group-hover:text-brand-800">
            Vergi takvimini aç →
          </span>
        </a>
      </section>
    )
  }

  <!-- Need-based tiles -->
  <section class="max-w-6xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
    <h2 class="text-[28px] md:text-[36px] font-bold tracking-[-0.025em] text-slate-900">
      Bugün ne yapmak istiyorsun?
    </h2>
    <p class="mt-2 text-[17px] text-slate-600">Bir iş seç, seni doğru rehbere götürelim.</p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { href: '/sahis-sirketi-nasil-kurulur/', icon: 'company', tone: 'rose', title: 'Şirketimi açacağım', blurb: 'Adım adım şahıs şirketi kurulumu' },
          { href: '/302-11-1-a-fatura-ornegi/', icon: 'invoice', tone: 'mint', title: 'İlk faturamı keseceğim', blurb: 'e-Arşiv\'de hangi alana ne yazılır' },
          { href: '/yurtdisindan-odeme-alma/', icon: 'transfer', tone: 'sky', title: 'Parayı Türkiye\'ye getireceğim', blurb: 'Wise, Payoneer ve banka süreci' },
          { href: '#hesapla', icon: 'calculator', tone: 'amber', title: 'Ne kadar vergi öderim?', blurb: '30 saniyede net kazancını gör' },
          { href: '/sahis-sirketi-maliyet/', icon: 'pen', tone: 'lilac', title: 'Aylık giderimi bilmek istiyorum', blurb: 'Bağ-Kur, mali müşavir, damga vergisi' },
          { href: '/hizmet-ihracati-istisnasi/', icon: 'calendar', tone: 'rose', title: 'Beyanname zamanı geldi', blurb: '%100 indirim ve YMM tasdiki' },
          { href: '/upwork-vergi/', icon: 'laptop', tone: 'mint', title: 'Upwork\'ten gelirim var', blurb: 'Faturayı kime, ne tutarla kesersin' },
          { href: '/remote-is-bulma/', icon: 'search', tone: 'sky', title: 'Remote iş arıyorum', blurb: 'İlan siteleri ve başvuru taktikleri' },
        ].map((t) => (
          <li>
            <a href={t.href} class="tile group flex h-full items-start gap-4 rounded-3xl bg-white border border-slate-200 p-5 hover:border-slate-300 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_-20px_oklch(0.21_0.016_25/0.3)] transition duration-300 ease-out-quart">
              <Illustration name={t.icon as IllustrationName} tone={t.tone as IllustrationTone} class="w-14 h-14 shrink-0 transition duration-300 ease-out-quart group-hover:scale-105" />
              <span class="pt-1">
                <span class="block text-[16px] font-semibold leading-snug text-slate-900">{t.title}</span>
                <span class="block mt-1 text-[14px] leading-snug text-slate-600">{t.blurb}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Personas -->
  <section class="max-w-6xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
    <div class="rounded-[2rem] bg-slate-900 text-white p-7 md:p-12">
      <div class="max-w-2xl">
        <h2 class="text-[28px] md:text-[36px] font-bold tracking-[-0.025em]">Sana özel yol haritası</h2>
        <p class="mt-2 text-[17px] text-slate-300">
          Ne iş yaptığını seç, baştan sona hangi adımları atacağını sırayla
          gösterelim.
        </p>
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          personas.map((p) => (
            <li>
              <a href={p.href} class="group flex h-full flex-col rounded-3xl bg-white/[0.06] border border-white/10 p-5 hover:bg-white/[0.1] hover:border-white/20 transition">
                <Illustration name={p.icon} tone={p.tone} class="w-14 h-14" />
                <span class="mt-4 text-[18px] font-semibold">{p.name}</span>
                <span class="mt-1 text-[14px] leading-snug text-slate-300">{p.short}</span>
                <span class="mt-auto pt-5 text-[14px] font-semibold text-brand-300 group-hover:text-brand-200 transition">
                  Yol haritamı göster →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Calculator -->
  <section id="hesapla" class="max-w-6xl mx-auto px-5 md:px-8 pt-16 md:pt-24 scroll-mt-20">
    <div class="max-w-2xl">
      <h2 class="text-[28px] md:text-[36px] font-bold tracking-[-0.025em] text-slate-900">
        Elinde ne kalıyor? Hemen hesapla.
      </h2>
      <p class="mt-2 text-[17px] text-slate-600">
        Aylık döviz gelirini gir. Bağ-Kur, mali müşavir, damga vergisi ve
        gerekiyorsa YMM dahil yıllık net kazancını gösterelim.
      </p>
    </div>
    <Calculator />
  </section>

  <!-- This year's numbers: our "rates" board -->
  <section class="max-w-6xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-[28px] md:text-[36px] font-bold tracking-[-0.025em] text-slate-900">
          Bu yıl bilmen gereken rakamlar
        </h2>
        <p class="mt-2 text-[17px] text-slate-600">2026 için, tek bakışta.</p>
      </div>
      <a href="/sozluk/" class="text-[15px] font-semibold text-brand-700 hover:text-brand-800">Terimler ne demek? Sözlük →</a>
    </div>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <li class="rate">
        <p class="rate-label">Hizmet ihracatı kazanç indirimi</p>
        <p class="rate-value !text-gain-700"><Fact name="hizmetIhracatiIndirimi" /></p>
        <p class="rate-note">2025'te %80'di. Şartları sağlarsan kazancına gelir vergisi çıkmaz.</p>
      </li>
      <li class="rate">
        <p class="rate-label">Bağ-Kur asgari prim</p>
        <p class="rate-value"><Fact name="bagkurAsgariAylik" /><span class="rate-unit">/ay</span></p>
        <p class="rate-note">Şirketi açtığın gün başlar. Asıl sabit giderin bu.</p>
      </li>
      <li class="rate">
        <p class="rate-label">YMM tasdik eşiği</p>
        <p class="rate-value"><Fact name="ymmIndirimEsigi" /></p>
        <p class="rate-note">Yıllık indirimin bunu geçerse yeminli mali müşavir raporu şart.</p>
      </li>
      <li class="rate">
        <p class="rate-label">Gelir vergisi dilimleri</p>
        <p class="rate-value"><Fact name="gelirVergisiEnDusukDilim" /><span class="rate-unit">ile</span><Fact name="gelirVergisiEnYuksekDilim" /></p>
        <p class="rate-note">İndirim dışında kalan kazanç, örneğin yurt içi gelir, bu tarifeyle vergilenir.</p>
      </li>
      <li class="rate">
        <p class="rate-label">Mali müşavir, TÜRMOB asgari</p>
        <p class="rate-value"><Fact name="smmmAsgariAylik" /><span class="rate-unit">/ay</span></p>
        <p class="rate-note">Piyasada yurt dışına çalışanlar için genelde biraz üstü.</p>
      </li>
      <li class="rate">
        <p class="rate-label">Uygulama geliri özel hesap sınırı</p>
        <p class="rate-value"><Fact name="uygulamaOzelHesapLimiti" /></p>
        <p class="rate-note">App Store ve Google Play için %15 stopaj yolunun yıllık üst sınırı.</p>
      </li>
    </ul>
    <p class="mt-4 text-[13px] text-slate-500">
      Rakamlar yaklaşıktır ve tek bir kaynaktan beslenir; hesaplayıcı da aynı rakamları kullanır.
    </p>
  </section>

  <!-- Trust -->
  <section class="max-w-6xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
    <h2 class="text-[28px] md:text-[36px] font-bold tracking-[-0.025em] text-slate-900">
      Neden bize güvenebilirsin?
    </h2>
    <div class="mt-8 grid gap-10 md:grid-cols-3">
      <div>
        <p class="num text-[40px] font-semibold tracking-tight text-slate-900">{guideCount}</p>
        <p class="mt-1 text-[17px] font-semibold text-slate-900">rehber, her birinde tarih</p>
        <p class="mt-2 text-[15px] leading-relaxed text-slate-600">
          Her rehberin başında en son ne zaman kontrol edildiği ve dayandığı
          mevzuat yazar. Eskiyen bilgi gizlenmez.
        </p>
      </div>
      <div>
        <p class="num text-[40px] font-semibold tracking-tight text-slate-900">%100</p>
        <p class="mt-1 text-[17px] font-semibold text-slate-900">açık kaynak</p>
        <p class="mt-2 text-[15px] leading-relaxed text-slate-600">
          Sitenin tamamı GitHub'da. Yanlış bir şey görürsen herkes gibi sen de
          düzeltme önerebilirsin.
        </p>
      </div>
      <div>
        <p class="num text-[40px] font-semibold tracking-tight text-slate-900">0 ₺</p>
        <p class="mt-1 text-[17px] font-semibold text-slate-900">satış, reklam, danışmanlık</p>
        <p class="mt-2 text-[15px] leading-relaxed text-slate-600">
          Sana bir şey satmıyoruz. Amaç, mali müşavirinle konuşurken neyin ne
          olduğunu bilmen.
        </p>
      </div>
