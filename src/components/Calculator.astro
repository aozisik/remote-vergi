---
// Unified calculator: handles yurt dışı (hizmet ihracatı istisnası) and optional
// yurt içi incomes. Year-aware: 2025 (%80 istisna) or 2026 (%100 istisna).
// Math lives in src/scripts/calculator.ts and is exposed as window.calculate.
//
// Pass `mixed={true}` to also show the yurt içi income input. Default false.

interface Props {
  mixed?: boolean;
}

const { mixed = false } = Astro.props;
---

<section
  x-data={`{
    mixed: ${mixed},
    currencies: {
      EUR: { symbol: '€', label: 'EUR' },
      USD: { symbol: '$', label: 'USD' },
      GBP: { symbol: '£', label: 'GBP' }
    },
    years: {
      2025: {
        currencyDefaults: { EUR: '45', USD: '40', GBP: '52' },
        accountingCost: '3800',
        ymmCost: '0',
        showYmm: false,
        accountingHelp: "TÜRMOB 2025 asgari tarifesi ₺3.775/ay'dan başlar.",
        exemptionPct: 80
      },
      2026: {
        currencyDefaults: { EUR: '53', USD: '35', GBP: '60' },
        accountingCost: '4500',
        ymmCost: '30000',
        showYmm: true,
        accountingHelp: "TÜRMOB 2026 asgari tarifesi ₺4.492/ay'dan başlar.",
        exemptionPct: 100
      }
    },
    yearOptions: [2025, 2026],
    setYear(year) {
      if (this.form.taxYear === year) return;
      const y = this.years[year];
      this.form.taxYear = year;
      this.form.exchangeRate = y.currencyDefaults[this.form.currency];
      this.form.accountingCosts = y.accountingCost;
      this.form.ymmCost = y.ymmCost;
    },
    cycleCurrency() {
      const order = ['EUR', 'USD', 'GBP'];
      const idx = order.indexOf(this.form.currency);
      const next = order[(idx + 1) % order.length];
      this.form.currency = next;
      this.form.exchangeRate = this.years[this.form.taxYear].currencyDefaults[next];
    },
    results: [],
    form: (() => {
      const YEAR_DEFAULTS = {
        2025: { rates: { EUR: '45', USD: '40', GBP: '52' }, acc: '3800', ymm: '0' },
        2026: { rates: { EUR: '53', USD: '35', GBP: '60' }, acc: '4500', ymm: '30000' }
      };
      const buildDefaults = (taxYear, currency) => {
        const y = YEAR_DEFAULTS[taxYear] || YEAR_DEFAULTS[2026];
        return {
          taxYear,
          yurtDisiIncome: '3000',
          yurtIciIncome: '0',
          currency,
          exchangeRate: y.rates[currency] || y.rates.EUR,
          accountingCosts: y.acc,
          ymmCost: y.ymm
        };
      };

      const params = new URLSearchParams(window.location.search);

      // Short-params format: ?y=2025&yd=4000&c=USD ...
      if (['y','yd','yi','c','r','a','m'].some(k => params.has(k))) {
        const taxYear = Number(params.get('y')) || 2026;
        const currency = params.get('c') || 'EUR';
        const d = buildDefaults(taxYear, currency);
        return {
          taxYear,
          yurtDisiIncome: params.get('yd') ?? d.yurtDisiIncome,
          yurtIciIncome: params.get('yi') ?? d.yurtIciIncome,
          currency,
          exchangeRate: params.get('r') ?? d.exchangeRate,
          accountingCosts: params.get('a') ?? d.accountingCosts,
          ymmCost: params.get('m') ?? d.ymmCost
        };
      }

      // Legacy base64 ?data= links (kept so old shares still work).
      const encoded = params.get('data');
      if (encoded) {
        try {
          const parsed = JSON.parse(atob(encoded));
          if (parsed.income !== undefined && parsed.yurtDisiIncome === undefined) {
            parsed.yurtDisiIncome = parsed.income;
            delete parsed.income;
          }
          if (parsed.yurtIciIncome === undefined) parsed.yurtIciIncome = '0';
          if (parsed.currency === undefined) parsed.currency = 'EUR';
          if (parsed.taxYear === undefined) parsed.taxYear = 2026;
          parsed.taxYear = Number(parsed.taxYear);
          return parsed;
        } catch (e) {
          console.error('Invalid share URL');
        }
      }

      return buildDefaults(2026, 'EUR');
    })(),
    copied: false,
    copyShare() {
      const y = this.years[this.form.taxYear];
      const expectedRate = y.currencyDefaults[this.form.currency];
      const params = new URLSearchParams();
      if (this.form.taxYear !== 2026) params.set('y', String(this.form.taxYear));
      if (this.form.yurtDisiIncome !== '3000') params.set('yd', this.form.yurtDisiIncome);
      if (this.form.yurtIciIncome !== '0') params.set('yi', this.form.yurtIciIncome);
      if (this.form.currency !== 'EUR') params.set('c', this.form.currency);
      if (this.form.exchangeRate !== expectedRate) params.set('r', this.form.exchangeRate);
      if (this.form.accountingCosts !== y.accountingCost) params.set('a', this.form.accountingCosts);
      if (this.form.ymmCost !== y.ymmCost) params.set('m', this.form.ymmCost);
      const qs = params.toString();
      const url = window.location.origin + window.location.pathname + (qs ? '?' + qs : '');
      navigator.clipboard.writeText(url);
      this.copied = true;
      setTimeout(() => this.copied = false, 1800);
    }
  }`}
  class="not-prose grid md:grid-cols-5 gap-5 md:gap-6 items-start my-8"
>
  <!-- Form -->
  <section class="card p-5 md:p-6 md:col-span-2 rise">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-sm font-semibold text-slate-900">Bilgiler</h2>
      <div
        class="inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 text-[12px] font-medium"
        role="group"
        aria-label="Vergi yılı"
      >
        <template x-for="y in yearOptions" :key="y">
          <button
            type="button"
            @click="setYear(y)"
            :class="form.taxYear === y ? 'bg-white text-indigo-700 shadow-sm border border-slate-200' : 'text-slate-500 hover:text-slate-700 border border-transparent'"
            class="px-2.5 py-1 rounded-md transition"
            x-text="y"
          ></button>
        </template>
      </div>
    </div>
    <div class="space-y-4">
      <label class="field">
        <span class="field-label">
          {mixed ? 'Aylık yurt dışı kazanç' : 'Aylık kazanç'}
        </span>
        <span class="field-input">
          <button
            type="button"
            class="prefix prefix-button"
            @click="cycleCurrency()"
            :title="`Para birimini değiştir (${currencies[form.currency].label})`"
            x-text="currencies[form.currency].symbol"
          ></button>
          <input
            type="number"
            inputmode="decimal"
            min="0"
            step="1"
            x-model="form.yurtDisiIncome"
          />
        </span>
        {
          mixed && (
            <span class="field-help">
              Yurt dışı tüzel kişi müşteriden döviz olarak gelen aylık tutar.
            </span>
          )
        }
      </label>

      {
        mixed && (
          <label class="field">
            <span class="field-label">Aylık yurt içi kazanç</span>
            <span class="field-input">
              <span class="prefix">₺</span>
              <input
                type="number"
                inputmode="decimal"
                min="0"
                step="1"
                x-model="form.yurtIciIncome"
              />
            </span>
            <span class="field-help">
              Türkiye'deki müşterilerden gelen aylık brüt tutar. Yurt içi geliriniz
              yoksa 0 bırakın.
            </span>
          </label>
        )
      }

      <label class="field">
        <span
          class="field-label"
          x-text="`${currencies[form.currency].label} / TRY kuru`"></span>
        <span class="field-input">
          <span class="prefix">₺</span>
          <input
            type="number"
            inputmode="decimal"
            min="1"
            step="0.01"
            x-model="form.exchangeRate"
          />
        </span>
      </label>

      <label class="field">
        <span class="field-label">Aylık muhasebe gideri</span>
        <span class="field-input">
          <span class="prefix">₺</span>
          <input
            type="number"
            inputmode="decimal"
            min="0"
            step="1"
            x-model="form.accountingCosts"
          />
        </span>
        <span
          class="field-help"
          x-text="years[form.taxYear].accountingHelp"></span>
      </label>

      <label class="field" x-show="years[form.taxYear].showYmm">
        <span class="field-label">Yıllık YMM tasdik ücreti</span>
        <span class="field-input">
          <span class="prefix">₺</span>
          <input
            type="number"
            inputmode="decimal"
            min="0"
            step="1"
            x-model="form.ymmCost"
          />
        </span>
        <span class="field-help"
          >Yıllık yurt dışı indirim tutarı 500.000 ₺'yi aşmadığında hesaba
          katılmaz.</span
        >
      </label>
    </div>
  </section>

  <!-- Result -->
  <section
    class="md:col-span-3 rise"
    style="animation-delay: 80ms;"
    x-data="{
      expandedSections: { expenses: true, taxes: true, income: true },
      groupedResults: {},
      async init() {
        results = await window.calculate(form);
        this.processResults(results);
        $watch('results', (value) => this.processResults(value));
      },
      processResults(results) {
        this.groupedResults = results.reduce((acc, item) => {
          const group = item[3];
          if (group) {
            if (!acc[group]) acc[group] = { items: [], total: '' };
            if (!item[1]) acc[group].total = item[0];
            else acc[group].items.push(item);
          } else {
            if (!acc.other) acc.other = [];
            acc.other.push(item);
          }
          return acc;
        }, {});
      },
      netAnnual() { const i = this.groupedResults.income; return i ? i.items.find(x => x[0].includes('Yıllık')) : null; },
      netMonthly() { const i = this.groupedResults.income; return i ? i.items.find(x => x[0].includes('Aylık Gelir') && !/[€$£]/.test(x[0])) : null; },
      netMonthlyForeign() { const i = this.groupedResults.income; return i ? i.items.find(x => /[€$£]/.test(x[0])) : null; },
      parseAmount(s) { return s ? Number(String(s).replace(/[^0-9]/g, '')) : 0; },
      formatTL(n) { return '₺' + new Intl.NumberFormat('tr-TR').format(Math.round(n)); },
      get pieNet() { return this.parseAmount(this.groupedResults.income?.items?.find(i => i[0].includes('Yıllık'))?.[1]); },
      get pieDamga() { return this.parseAmount(this.groupedResults.expenses?.items?.find(i => i[0].includes('Damga'))?.[1]); },
      get pieVergi() {
        const incomeTax = this.parseAmount(this.groupedResults.taxes?.items?.find(i => i[4] === 'total')?.[1]);
        return incomeTax + this.pieDamga;
      },
      get pieSigorta() { return this.parseAmount(this.groupedResults.expenses?.items?.find(i => i[0].includes('Bağkur'))?.[1]); },
      get pieMuhasebe() {
        const exp = this.groupedResults.expenses;
        if (!exp) return 0;
        const total = this.parseAmount(exp.items.find(i => i[4] === 'total')?.[1]);
        return Math.max(0, total - this.pieSigorta - this.pieDamga);
      },
      get pieTotal() { return this.pieNet + this.pieVergi + this.pieSigorta + this.pieMuhasebe; },
      get pieSegments() {
        const total = this.pieTotal || 1;
        return [
          { label: 'Net Gelir', value: this.pieNet, color: '#4f46e5' },
          { label: 'Vergi', value: this.pieVergi, color: '#dc2626' },
          { label: 'Sigorta', value: this.pieSigorta, color: '#d97706' },
          { label: 'Muhasebe', value: this.pieMuhasebe, color: '#475569' }
        ].map(s => ({
          ...s,
          amount: this.formatTL(s.value),
          pctNum: (s.value / total) * 100,
          pct: ((s.value / total) * 100).toFixed(1) + '%'
        }));
      },
      get pieStyle() {
        const total = this.pieTotal || 1;
        let cursor = 0;
        const stops = this.pieSegments.map(s => {
          const start = cursor;
          cursor += (s.value / total) * 100;
          return s.color + ' ' + start + '% ' + cursor + '%';
        });
        return 'background: conic-gradient(' + stops.join(', ') + ');';
      }
    }"
    x-init="results = await window.calculate(form); $watch('form', async (value) => results = await window.calculate(value))"
  >
    <!-- Hero number card -->
    <div
      class="card p-5 md:p-6 mb-5 bg-gradient-to-br from-indigo-50/40 via-white to-white border-indigo-100"
    >
      <p
        class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-1.5"
      >
        Net Yıllık Kazanç
      </p>
      <p
        class="num font-semibold text-slate-900 tracking-tight leading-tight break-words text-2xl md:text-3xl"
        x-text="netAnnual() ? netAnnual()[1] : '–'"
      >
      </p>

      <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-slate-100">
        <div>
          <p
            class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-0.5"
          >
            Aylık (₺)
          </p>
          <p
            class="num text-base md:text-lg font-semibold text-slate-900 break-words"
            x-text="netMonthly() ? netMonthly()[1] : '–'"
          >
          </p>
        </div>
        <div>
          <p
            class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-0.5"
            x-text="`Aylık (${currencies[form.currency].symbol})`"
          >
          </p>
          <p
            class="num text-base md:text-lg font-semibold text-slate-900 break-words"
            x-text="netMonthlyForeign() ? netMonthlyForeign()[1] : '–'"
          >
          </p>
        </div>
      </div>
    </div>

    <!-- Validation messages -->
    <template
      x-for="item in groupedResults.other?.filter(item => item[4] === 'before')"
      :key="item[0]"
    >
      <div class="card p-4 mb-5 border-amber-200 bg-amber-50">
        <p class="text-[14px] text-amber-900 font-medium" x-text="item[0]"></p>
      </div>
    </template>

    <!-- Distribution chart -->
    <template x-if="pieTotal > 0">
      <div class="card p-5 md:p-6 mb-5">
        <p
          class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-4"
        >
          Dağılım
        </p>
        <div class="flex items-center gap-5 md:gap-7 flex-wrap">
          <div
            class="relative w-24 h-24 md:w-28 md:h-28 rounded-full shrink-0"
            :style="pieStyle"
          >
            <div class="absolute inset-[22%] rounded-full bg-white"></div>
          </div>
          <div class="flex-1 min-w-[180px] space-y-2.5">
            <template x-for="seg in pieSegments" :key="seg.label">
              <div class="flex items-center justify-between gap-3 text-[13px]">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span
                    class="w-2.5 h-2.5 rounded-sm shrink-0"
                    :style="`background: ${seg.color}`"></span>
                  <span class="text-slate-700" x-text="seg.label"></span>
                </div>
                <div class="flex items-baseline gap-3 shrink-0">
                  <span
                    class="num text-slate-500 text-[12px]"
                    x-text="seg.amount"></span>
                  <span
                    class="num text-slate-900 font-medium w-12 text-right"
                    x-text="seg.pct"></span>
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- Breakdown card -->
    <div class="card overflow-hidden">
      <template
        x-for="(label, groupName) in {
          'expenses': 'Sabit Giderler',
          'taxes': 'Vergiler'
        }"
        :key="groupName"
      >
        <template x-if="groupedResults[groupName]">
          <div class="border-b border-slate-100 last:border-b-0">
            <button
              type="button"
              @click="expandedSections[groupName] = !expandedSections[groupName]"
              class="w-full flex items-center justify-between p-4 md:px-5 hover:bg-slate-50 transition group"
            >
              <div class="flex items-center gap-3">
                <span
                  class="chev text-slate-400"
                  :class="expandedSections[groupName] ? 'open text-slate-700' : ''"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="w-3.5 h-3.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
                <span
                  class="text-[14px] font-medium text-slate-900"
                  x-text="label"></span>
              </div>
              <span
                class="num text-[14px] font-semibold text-slate-900"
                x-text="groupedResults[groupName].items.find(item => item[4] === 'total')[1]"
              ></span>
            </button>
            <div
              x-show="expandedSections[groupName]"
              x-transition.opacity
              class="px-5 pb-4 pt-1 bg-slate-50/60 border-t border-slate-100"
            >
              <template
                x-for="item in groupedResults[groupName].items.filter(item => item[4] !== 'total')"
                :key="item[0]"
              >
                <div class="flex items-center justify-between py-2 text-[13px]">
                  <span class="text-slate-600 pr-3">
                    <template x-if="!item[2]">
                      <span x-text="item[0]"></span>
                    </template>
                    <template x-if="item[2]">
                      <a
                        x-bind:href="item[2]"
                        target="_blank"
                        class="text-indigo-600 hover:text-indigo-800 hover:underline"
                        x-text="item[0]"></a>
                    </template>
                  </span>
                  <span
                    class="num text-slate-900 font-medium whitespace-nowrap"
                    x-text="item[1]"></span>
                </div>
              </template>
            </div>
          </div>
        </template>
      </template>
    </div>

    <!-- Share -->
    <div class="mt-5 flex items-center justify-between text-[13px]">
      <span class="text-slate-500">Bu hesabı paylaş</span>
      <button
        @click="copyShare()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:border-indigo-300 hover:text-indigo-700 hover:bg-indigo-50 font-medium transition"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="w-3.5 h-3.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184"
          ></path>
        </svg>
        <span x-show="!copied">Linki kopyala</span>
        <span x-show="copied" style="color: #4f46e5;">Kopyalandı</span>
      </button>
    </div>
  </section>
</section>

<style is:global>
  .field-input .prefix-button {
    cursor: pointer;
    border: 0;
    border-right: 1px solid #e2e8f0;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .field-input .prefix-button:hover {
    background: #eef2ff;
    color: #4f46e5;
  }
  .field-input .prefix-button:focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: -2px;
  }
</style>

<script>
  import Alpine from 'alpinejs';
  import { calculate } from '../scripts/calculator';

  // Alpine x-init / x-data inline expressions reference window.calculate.
  (window as any).calculate = calculate;
  (window as any).Alpine = Alpine;
  Alpine.start();
</script>
