---
// Sosyal İçerik / Mobil Uygulama Geliştiriciliği İstisnası (GVK Mük. 20/B)
// için basit hesaplayıcı. Aylık brüt gelir + Bağ-Kur → yıllık brüt, %15 stopaj,
// Bağ-Kur ve net. 5.300.000 TL (2026) limit aşılırsa uyarı verir.
---

<section
  class="not-prose my-8 rounded-2xl border border-slate-200 bg-white overflow-hidden"
  data-mobile-app-calc
>
  <header class="px-5 md:px-6 py-4 border-b border-slate-100 bg-slate-50">
    <h3 class="text-sm font-semibold text-slate-900">
      Özel hesap rejiminde elime ne geçer?
    </h3>
    <p class="text-[12px] text-slate-500 mt-1 leading-relaxed">
      Apple/Google'dan aldığınız aylık ödemeyi girin. Banka %15 stopajı kaynakta
      keser; Bağ-Kur'u siz cebinizden ödersiniz. 2026 hadleri.
    </p>
  </header>

  <div class="grid md:grid-cols-2 gap-5 md:gap-8 p-5 md:p-6">
    <!-- Form -->
    <div class="space-y-4">
      <label class="field">
        <span class="field-label">Aylık brüt gelir</span>
        <span class="field-input">
          <button
            type="button"
            class="prefix"
            data-currency-toggle
            style="cursor: pointer; user-select: none;"
            aria-label="Para birimini değiştir">$</button>
          <input
            type="number"
            inputmode="decimal"
            min="0"
            step="100"
            value="3000"
            data-income
          />
        </span>
        <span class="field-help" data-income-help>
          Apple/Google'ın size aylık aktardığı net royalty tutarı.
        </span>
      </label>

      <label class="field" data-rate-field>
        <span class="field-label" data-rate-label>USD / TRY kuru</span>
        <span class="field-input">
          <span class="prefix">₺</span>
          <input
            type="number"
            inputmode="decimal"
            min="1"
            step="0.01"
            value="35"
            data-rate
          />
        </span>
      </label>

      <label class="field">
        <span class="field-label">Aylık Bağ-Kur primi</span>
        <span class="field-input">
          <span class="prefix">₺</span>
          <input
            type="number"
            inputmode="decimal"
            min="0"
            step="100"
            value="12000"
            data-bagkur
          />
        </span>
        <span class="field-help">
          2026 asgari prim yaklaşık ₺12.000/ay. Prime esas kazancınızı asgari
          ile tavan arasında siz beyan edersiniz; geliriniz otomatik
          yükseltmez. Çoğu kişi asgari öder.
        </span>
      </label>
    </div>

    <!-- Result -->
    <div class="space-y-5">
      <!-- Hero -->
      <div
        class="rounded-xl border border-indigo-100 bg-gradient-to-br from-indigo-50/40 via-white to-white p-5"
      >
        <p
          class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-1.5"
        >
          Yıllık net (elinize geçen)
        </p>
        <p
          class="num text-2xl md:text-3xl font-semibold text-slate-900 tracking-tight"
          data-result-net
        >
          ₺0
        </p>
        <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-indigo-100">
          <div>
            <p
              class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-0.5"
            >
              Aylık (₺)
            </p>
            <p
              class="num text-base md:text-lg font-semibold text-slate-900"
              data-result-net-monthly-tl
            >
              ₺0
            </p>
          </div>
          <div>
            <p
              class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-0.5"
              data-result-net-monthly-currency-label
            >
              Aylık ($)
            </p>
            <p
              class="num text-base md:text-lg font-semibold text-slate-900"
              data-result-net-monthly-currency
            >
              $0
            </p>
          </div>
        </div>
      </div>

      <!-- Pie + legend with amounts -->
      <div class="rounded-xl border border-slate-200 p-5" data-pie-wrap>
        <div class="flex items-baseline justify-between mb-4 gap-3">
          <p
            class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold"
          >
            Dağılım
          </p>
          <p class="text-[12px] text-slate-500">
            Yıllık brüt
            <span
              class="num font-medium text-slate-900 ml-1"
              data-result-gross
              >₺0</span
            >
          </p>
        </div>
        <div class="flex items-center gap-5 flex-wrap">
          <div
            class="relative w-24 h-24 rounded-full shrink-0"
            data-pie
            style="background: conic-gradient(#4f46e5 0% 100%);"
          >
            <div class="absolute inset-[22%] rounded-full bg-white"></div>
          </div>
          <div class="flex-1 min-w-[180px] space-y-3">
            <div class="flex items-center justify-between gap-3 text-[13px]">
              <div class="flex items-center gap-2.5 min-w-0">
                <span
                  class="inline-block w-2.5 h-2.5 rounded-sm shrink-0"
                  style="background: #4f46e5;"></span>
                <span class="text-slate-700">Net</span>
              </div>
              <div class="text-right">
                <div
                  class="num font-medium text-slate-900"
                  data-pie-net-amount
                >
                  ₺0
                </div>
                <div class="num text-[11px] text-slate-500" data-pie-net-pct>
                  0%
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between gap-3 text-[13px]">
              <div class="flex items-center gap-2.5 min-w-0">
                <span
                  class="inline-block w-2.5 h-2.5 rounded-sm shrink-0"
                  style="background: #dc2626;"></span>
                <span class="text-slate-700">%15 stopaj</span>
              </div>
              <div class="text-right">
                <div
                  class="num font-medium text-rose-600"
                  data-pie-tax-amount
                >
                  ₺0
                </div>
                <div class="num text-[11px] text-slate-500" data-pie-tax-pct>
                  0%
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between gap-3 text-[13px]">
              <div class="flex items-center gap-2.5 min-w-0">
                <span
                  class="inline-block w-2.5 h-2.5 rounded-sm shrink-0"
                  style="background: #d97706;"></span>
                <span class="text-slate-700">Bağ-Kur</span>
              </div>
              <div class="text-right">
                <div
                  class="num font-medium text-amber-700"
                  data-pie-bagkur-amount
                >
                  ₺0
                </div>
                <div
                  class="num text-[11px] text-slate-500"
                  data-pie-bagkur-pct
                >
                  0%
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="hidden rounded-lg border border-amber-300 bg-amber-50 p-3 text-[12px] text-amber-900 leading-relaxed"
        data-limit-warning
      >
        <strong>Uyarı:</strong> Yıllık brüt ₺5.300.000 (2026) limitini aşıyor.
        Bu rejim aşıldığı yıl için tamamen düşer; kazancın tamamı normal şahıs
        şirketi gelir vergisi tarifesi (%15 ile %40) ile beyan edilir. Bu durumda
        şahıs şirketi + hizmet ihracatı yolunu değerlendirin.
      </div>
    </div>
  </div>
</section>

<script>
  type Currency = 'USD' | 'EUR' | 'GBP' | 'TRY';

  const SYMBOLS: Record<Currency, string> = {
    USD: '$',
    EUR: '€',
    GBP: '£',
    TRY: '₺',
  };
  const DEFAULT_RATES: Record<Currency, string> = {
    USD: '35',
    EUR: '40',
    GBP: '45',
    TRY: '1',
  };
  const ORDER: Currency[] = ['USD', 'EUR', 'GBP', 'TRY'];
  const ANNUAL_LIMIT_2026 = 5_300_000;

  const fmtTL = (n: number) =>
    '₺' + new Intl.NumberFormat('tr-TR').format(Math.round(n));
  const fmtCurrency = (n: number, c: Currency) =>
    SYMBOLS[c] + new Intl.NumberFormat('tr-TR').format(Math.round(n));

  document
    .querySelectorAll<HTMLElement>('[data-mobile-app-calc]')
    .forEach((root) => {
      const incomeEl = root.querySelector<HTMLInputElement>('[data-income]')!;
      const rateEl = root.querySelector<HTMLInputElement>('[data-rate]')!;
      const rateField = root.querySelector<HTMLElement>('[data-rate-field]')!;
      const rateLabel = root.querySelector<HTMLElement>('[data-rate-label]')!;
      const bagkurEl = root.querySelector<HTMLInputElement>('[data-bagkur]')!;
      const currencyBtn = root.querySelector<HTMLButtonElement>(
        '[data-currency-toggle]'
      )!;
      const incomeHelp = root.querySelector<HTMLElement>('[data-income-help]')!;

      const grossEl = root.querySelector<HTMLElement>('[data-result-gross]')!;
      const netEl = root.querySelector<HTMLElement>('[data-result-net]')!;
      const netMonthlyTLEl = root.querySelector<HTMLElement>(
        '[data-result-net-monthly-tl]'
      )!;
      const netMonthlyCurrencyEl = root.querySelector<HTMLElement>(
        '[data-result-net-monthly-currency]'
      )!;
      const netMonthlyCurrencyLabel = root.querySelector<HTMLElement>(
        '[data-result-net-monthly-currency-label]'
      )!;
      const limitWarn = root.querySelector<HTMLElement>(
        '[data-limit-warning]'
      )!;

      const pieEl = root.querySelector<HTMLElement>('[data-pie]')!;
      const pieNetAmount = root.querySelector<HTMLElement>(
        '[data-pie-net-amount]'
      )!;
      const pieNetPct = root.querySelector<HTMLElement>('[data-pie-net-pct]')!;
      const pieTaxAmount = root.querySelector<HTMLElement>(
        '[data-pie-tax-amount]'
      )!;
      const pieTaxPct = root.querySelector<HTMLElement>('[data-pie-tax-pct]')!;
      const pieBagkurAmount = root.querySelector<HTMLElement>(
        '[data-pie-bagkur-amount]'
      )!;
      const pieBagkurPct = root.querySelector<HTMLElement>(
        '[data-pie-bagkur-pct]'
      )!;

      let currency: Currency = 'USD';

      const calc = () => {
        const income = Number(incomeEl.value) || 0;
        const rate = currency === 'TRY' ? 1 : Number(rateEl.value) || 0;
        const bagkurMonthly = Number(bagkurEl.value) || 0;

        const monthlyTL = income * rate;
        const annualGross = monthlyTL * 12;
        const annualTax = annualGross * 0.15;
        const annualBagkur = bagkurMonthly * 12;
        const annualNet = annualGross - annualTax - annualBagkur;

        grossEl.textContent = fmtTL(annualGross);
        netEl.textContent = fmtTL(annualNet);

        netMonthlyTLEl.textContent = fmtTL(annualNet / 12);
        if (currency === 'TRY' || rate <= 0) {
          netMonthlyCurrencyLabel.textContent = 'Aylık (₺)';
          netMonthlyCurrencyEl.textContent = fmtTL(annualNet / 12);
        } else {
          netMonthlyCurrencyLabel.textContent = `Aylık (${SYMBOLS[currency]})`;
          netMonthlyCurrencyEl.textContent = fmtCurrency(
            annualNet / 12 / rate,
            currency
          );
        }

        // Pie chart segments — sum is annual gross
        const total = annualGross > 0 ? annualGross : 1;
        const netClamped = Math.max(0, annualNet);
        const netPct = (netClamped / total) * 100;
        const taxPct = (annualTax / total) * 100;
        const bagkurPct = (annualBagkur / total) * 100;
        const netEnd = netPct;
        const taxEnd = netPct + taxPct;
        pieEl.style.background = `conic-gradient(#4f46e5 0% ${netEnd}%, #dc2626 ${netEnd}% ${taxEnd}%, #d97706 ${taxEnd}% 100%)`;

        pieNetAmount.textContent = fmtTL(netClamped);
        pieNetPct.textContent = netPct.toFixed(1) + '%';
        pieTaxAmount.textContent = '-' + fmtTL(annualTax);
        pieTaxPct.textContent = taxPct.toFixed(1) + '%';
        pieBagkurAmount.textContent = '-' + fmtTL(annualBagkur);
        pieBagkurPct.textContent = bagkurPct.toFixed(1) + '%';

        limitWarn.classList.toggle('hidden', annualGross <= ANNUAL_LIMIT_2026);
      };

      currencyBtn.addEventListener('click', () => {
        const idx = ORDER.indexOf(currency);
        currency = ORDER[(idx + 1) % ORDER.length];
        currencyBtn.textContent = SYMBOLS[currency];
        if (currency === 'TRY') {
          rateField.style.display = 'none';
          incomeHelp.textContent =
            'Apple/Google ödemesinin TL karşılığı (banka dekontundan).';
        } else {
          rateField.style.display = '';
          rateLabel.textContent = `${currency} / TRY kuru`;
          rateEl.value = DEFAULT_RATES[currency];
          incomeHelp.textContent =
            "Apple/Google'ın size aylık aktardığı net royalty tutarı.";
        }
        calc();
      });

      [incomeEl, rateEl, bagkurEl].forEach((el) => {
        el.addEventListener('input', calc);
      });

      calc();
    });
</script>
