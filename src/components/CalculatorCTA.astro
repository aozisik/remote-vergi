---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vergi yükünüzü hesaplayın',
  description = '2026 mevzuatına göre net kazancınızı, ödeyeceğiniz vergileri ve YMM dahil giderleri saniyeler içinde görün.',
} = Astro.props;
---

<aside
  class="not-prose my-10 rounded-2xl bg-slate-900 text-white p-6 md:p-7"
>
  <div class="flex items-start gap-5 flex-col md:flex-row md:items-center">
    <div class="flex-1 min-w-0">
      <h3 class="text-[18px] font-semibold tracking-[-0.01em] mb-1.5">{title}</h3>
      <p class="text-[15px] text-slate-300 leading-relaxed">{description}</p>
    </div>
    <a
      href="/#hesapla"
      class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-brand-500 text-white text-[14px] font-semibold hover:bg-brand-400 transition shrink-0"
    >
      Hesaplayıcıyı aç
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>
