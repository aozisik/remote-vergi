---
// "What comes next" box for the end of a guide: turns a finished read into the
// next click instead of a bounce. Clicks are sent to Plausible as a
// "Next Step" event (props: from, to) so each box's pull can be measured.
import Illustration from './Illustration.astro';
import {
  type IllustrationName,
  type IllustrationTone,
  personas,
} from '../data/site';

interface Step {
  href: string;
  title: string;
  blurb: string;
  icon: IllustrationName;
  tone: IllustrationTone;
}

interface Props {
  title: string;
  intro?: string;
  steps: Step[];
  showPersonas?: boolean;
}

const { title, intro, steps, showPersonas = true } = Astro.props;
const from = Astro.url.pathname;
---

<aside
  class="not-prose my-12 rounded-3xl border border-slate-200 bg-white p-6 md:p-8"
  data-next-steps={from}
>
  <h2 class="text-[22px] md:text-[26px] font-bold tracking-[-0.02em] text-slate-900">
    {title}
  </h2>
  {intro && <p class="mt-1.5 text-[15px] leading-relaxed text-slate-600">{intro}</p>}

  <ol class="mt-6 grid gap-3 md:grid-cols-3">
    {
      steps.map((s) => (
        <li>
          <a
            href={s.href}
            data-next-step={s.href}
            class="group flex h-full flex-col rounded-2xl border border-slate-200 p-4 hover:border-slate-300 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_-20px_oklch(0.21_0.016_25/0.3)] transition duration-300 ease-out-quart"
          >
            <Illustration name={s.icon} tone={s.tone} class="w-12 h-12" />
            <span class="mt-3 text-[16px] font-semibold leading-snug text-slate-900 group-hover:text-brand-700 transition">
              {s.title}
            </span>
            <span class="mt-1 text-[14px] leading-snug text-slate-600">{s.blurb}</span>
            <span class="mt-auto pt-3 text-[14px] font-semibold text-brand-700" aria-hidden="true">
              Devam et →
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  {
    showPersonas && (
      <div class="mt-6 pt-5 border-t border-slate-100 flex flex-wrap items-center gap-2">
        <span class="text-[14px] text-slate-600 mr-1">Tüm yolu sırayla görmek için:</span>
        {personas.map((p) => (
          <a
            href={p.href}
            data-next-step={p.href}
            class="inline-flex items-center h-10 px-4 rounded-full border border-slate-200 text-[14px] font-medium text-slate-800 hover:border-brand-300 hover:text-brand-700 transition"
          >
            {p.name}
          </a>
        ))}
      </div>
    )
  }
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-next-steps]').forEach((box) => {
    const from = box.dataset.nextSteps ?? location.pathname;
    box.querySelectorAll<HTMLAnchorElement>('[data-next-step]').forEach((link) => {
      link.addEventListener('click', () => {
        (window as any).plausible?.('Next Step', {
          props: { from, to: link.dataset.nextStep ?? link.href },
        });
      });
    });
  });
</script>
