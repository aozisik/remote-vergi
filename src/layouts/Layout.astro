---
import { getGuides } from '../data/guides';
import { personas, type TopicId, tools, topics } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  dateModified?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  dateModified,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://remotevergi.com/';
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteUrl).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://remotevergi.com/#organization',
  name: 'Remote Vergi',
  url: 'https://remotevergi.com/',
  logo: 'https://remotevergi.com/icon-512.png',
  sameAs: ['https://github.com/aozisik/remote-vergi'],
  parentOrganization: {
    '@type': 'Organization',
    name: 'Swiftmade OÜ',
    url: 'https://swiftmade.co',
  },
};

const currentPath = Astro.url.pathname;
const allGuides = await getGuides();
const byTopic = (id: TopicId) => allGuides.filter((g) => g.topic === id);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ahmet Özışık" />
    {dateModified && <meta name="last-modified" content={dateModified} />}

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Remote Vergi" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
