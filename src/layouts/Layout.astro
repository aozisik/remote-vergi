            Bilgilendirme amaçlıdır, mali danışmanlık yerine geçmez. Kendi
            durumun için bir mali müşavire danış. Hesaplamalar yaklaşık
            değerlerdir.
          </p>
          <div class="shrink-0 md:text-right">
            <div>
              Geliştirici:
              <a
                href="https://ahmet.ee"
                target="_blank"
                rel="noopener"
                class="text-slate-200 hover:text-white transition">Ahmet Özışık</a
              >,
              <a
                href="https://swiftmade.co"
                target="_blank"
                rel="noopener"
                class="text-slate-200 hover:text-white transition">Swiftmade OÜ</a
              >
            </div>
            <div class="mt-1">
              {dateModified ? `Son güncelleme: ${dateModified}` : 'Son güncelleme: 6 Mayıs 2026'}
            </div>
          </div>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --brand: oklch(0.52 0.19 26);
        --brand-deep: oklch(0.38 0.14 26);
        --brand-wash: oklch(0.97 0.014 26);
        --line: oklch(0.91 0.007 25);
        --ink: oklch(0.21 0.016 25);
        --gain: oklch(0.5 0.11 160);

        --pagefind-ui-primary: oklch(0.52 0.19 26);
        --pagefind-ui-text: oklch(0.21 0.016 25);
        --pagefind-ui-border: oklch(0.91 0.007 25);
        --pagefind-ui-tag: oklch(0.955 0.005 25);
        --pagefind-ui-font: 'Bricolage Grotesque', system-ui, sans-serif;
      }

      html {
        scroll-padding-top: 5.5rem;
      }

      body {
        font-optical-sizing: auto;
      }

      h1,
      h2,
      h3 {
        text-wrap: balance;
      }

      .rv-prose {
        --tw-prose-body: oklch(0.3 0.016 25);
        --tw-prose-headings: oklch(0.21 0.016 25);
        --tw-prose-bold: oklch(0.21 0.016 25);
        --tw-prose-links: oklch(0.45 0.17 26);
        --tw-prose-bullets: oklch(0.67 0.16 26);
        --tw-prose-counters: oklch(0.45 0.17 26);
        --tw-prose-quotes: oklch(0.3 0.016 25);
        --tw-prose-th-borders: oklch(0.85 0.009 25);
        --tw-prose-td-borders: oklch(0.91 0.007 25);
        font-family: Literata, ui-serif, Georgia, serif;
        font-size: 1.0625rem;
        line-height: 1.75;
      }
      .rv-prose :where(h1, h2, h3, h4, th, figcaption, table, .not-prose) {
        font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
      }
      .rv-prose :where(h1):not(:where(.not-prose *)) {
        font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
        font-weight: 700;
        margin-bottom: 0;
      }
      .rv-prose :where(h2):not(:where(.not-prose *)) {
        font-size: 1.625rem;
        line-height: 1.2;
        letter-spacing: -0.015em;
        font-weight: 650;
        margin-top: 3em;
        margin-bottom: 0.7em;
      }
      .rv-prose :where(h3):not(:where(.not-prose *)) {
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        font-weight: 650;
        margin-top: 2.2em;
      }
      .rv-prose :where(p, li) {
        text-wrap: pretty;
      }
      .rv-prose :where(a):not(:where(.not-prose *)) {
        font-weight: 500;
        text-decoration-color: oklch(0.88 0.06 26);
        text-underline-offset: 3px;
        text-decoration-thickness: 1.5px;
        transition: text-decoration-color 150ms ease;
      }
      .rv-prose :where(a):not(:where(.not-prose *)):hover {
        text-decoration-color: currentColor;
      }
      .rv-prose :where(table) {
        font-size: 0.875rem;
        display: block;
        overflow-x: auto;
      }
      .rv-prose :where(th) {
        background: oklch(0.975 0.004 25);
        padding: 0.6em 0.75em !important;
      }
      .rv-prose :where(blockquote) {
        font-style: normal;
        border: 1px solid oklch(0.88 0.06 26);
        background: oklch(0.97 0.014 26);
        border-radius: 0.875rem;
        padding: 0.25em 1.25em;
      }
      .rv-prose :where(blockquote p:first-of-type)::before,
      .rv-prose :where(blockquote p:last-of-type)::after {
        content: none;
      }
      .rv-prose :where(code):not(:where(pre code)) {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.85em;
        font-weight: 500;
        background: oklch(0.955 0.005 25);
        padding: 0.15em 0.4em;
        border-radius: 0.375rem;
      }
      .rv-prose :where(code):not(:where(pre code))::before,
      .rv-prose :where(code):not(:where(pre code))::after {
        content: none;
      }


      .num {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-variant-numeric: tabular-nums;
        font-feature-settings: 'tnum';
      }

      .nav-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        height: 2.5rem;
        padding: 0 0.75rem;
        border-radius: 0.5rem;
        cursor: pointer;
        list-style: none;
        user-select: none;
        transition: background-color 150ms ease, color 150ms ease;
      }
      .nav-trigger::-webkit-details-marker {
        display: none;
      }
      .nav-trigger:hover,
      details[open] > .nav-trigger {
        background: oklch(0.955 0.005 25);
        color: var(--ink);
      }

      .nav-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 0;
        z-index: 30;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        box-shadow:
          0 1px 2px oklch(0.21 0.016 25 / 0.04),
          0 16px 40px -12px oklch(0.21 0.016 25 / 0.18);
        animation: panel-in 180ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      @keyframes panel-in {
        from {
          opacity: 0;
          transform: translateY(-4px);
        }
      }

      details[open] > summary > .nav-chev {
        transform: rotate(180deg);
      }
      .nav-chev {
        transition: transform 200ms ease;
      }

      .mobile-sheet[open] {
        animation: sheet-in 260ms cubic-bezier(0.25, 1, 0.5, 1);
      }
      @keyframes sheet-in {
        from {
          transform: translateX(24px);
          opacity: 0;
        }
      }

      .field {
        display: block;
      }

      .field-label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: oklch(0.35 0.016 25);
        margin-bottom: 6px;
      }

      .field-input {
        display: flex;
        align-items: stretch;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 10px;
        transition: border-color 150ms ease, box-shadow 150ms ease;
        overflow: hidden;
      }

      .field-input:hover {
        border-color: oklch(0.85 0.009 25);
      }

      .field-input:focus-within {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px oklch(0.52 0.19 26 / 0.14);
      }

      .field-input .prefix {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 14px;
        font-weight: 500;
        color: oklch(0.42 0.016 25);
        background: oklch(0.975 0.004 25);
        border-right: 1px solid var(--line);
      }

      .field-input input {
        flex: 1;
        min-width: 0;
        min-height: 46px;
        padding: 11px 14px;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-variant-numeric: tabular-nums;
        font-size: 16px;
        font-weight: 500;
        color: var(--ink);
        background: transparent;
        border: 0;
        outline: 0;
      }

      .field-input input::-webkit-outer-spin-button,
      .field-input input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }

      .field-input input {
        -moz-appearance: textfield;
      }

      .field-help {
        font-size: 13px;
        line-height: 1.5;
        color: oklch(0.45 0.015 25);
        margin-top: 6px;
      }

      .card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 16px;
      }

      .chev {
        transition: transform 200ms ease;
      }

      .chev.open {
        transform: rotate(90deg);
      }

      ::selection {
        background: oklch(0.88 0.06 26);
        color: var(--ink);
      }

      :focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 2px;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .rise {
        animation: rise 400ms cubic-bezier(0.25, 1, 0.5, 1) both;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 1ms !important;
          animation-delay: 0ms !important;
          transition-duration: 1ms !important;
        }
      }
    </style>
  </body>
</html>
