      .field-input input {
        flex: 1;
        min-width: 0;
        padding: 11px 14px;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-variant-numeric: tabular-nums;
        font-size: 15px;
        font-weight: 500;
        color: #0f172a;
        background: transparent;
        border: 0;
        outline: 0;
      }

      .field-input input::-webkit-outer-spin-button,
