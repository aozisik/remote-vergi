        border-radius: 16px;
      }

      .chev {
        transition: transform 200ms ease;
      }

      .chev.open {
        transform: rotate(90deg);
      }

      details[open] > summary > .nav-chev {
        transform: rotate(180deg);
      }

      ::selection {
        background: #6366f1;
        color: #ffffff;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .rise {
        animation: rise 400ms ease-out both;
      }
    </style>
