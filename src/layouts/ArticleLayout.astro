---
import Layout from './Layout.astro';
import { getGuidesByTopic } from '../data/guides';
import { personas, type TopicId, topicById } from '../data/site';

interface FrontmatterShape {
  title: string;
  description: string;
  dateModified?: string;
  faq?: Array<{ question: string; answer: string }>;
  wide?: boolean;
  ogImage?: string;
  topic?: TopicId;
  summary?: string[];
  sources?: Array<{ label: string; url: string }>;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

// Astro passes MD/MDX frontmatter as Astro.props.frontmatter; .astro pages pass
// props directly. Support both so this layout works with either.
const frontmatter =
  (Astro.props as any).frontmatter ?? (Astro.props as FrontmatterShape);
const headings: Heading[] = (Astro.props as any).headings ?? [];
const editPath: string =
  (Astro.props as any).editPath ??
  `src/pages/${Astro.url.pathname.replace(/^\/+|\/+$/g, '')}.mdx`;
const {
  title,
  description,
  dateModified,
  faq,
  wide,
  ogImage,
  topic: topicId,
  summary,
  sources,
}: FrontmatterShape = frontmatter;
const fullTitle = title.includes('Remote Vergi')
  ? title
 : `${title} | Remote Vergi`;

const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const resolvedOgImage = ogImage ?? `/og/${slug}.png`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const topic = topicId ? topicById(topicId) : undefined;
const related = topicId
  ? (await getGuidesByTopic(topicId)).filter(
      (g) => g.href !== Astro.url.pathname
    )
  : [];
const toc = headings.filter((h) => h.depth === 2);

const verifiedOn = new Date(dateModified ?? '2026-05-07').toLocaleDateString(
  'tr-TR',
  { day: 'numeric', month: 'long', year: 'numeric' }
);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: new URL(resolvedOgImage, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: 'Ahmet Özışık',
    url: 'https://ahmet.ee',
    sameAs: [
      'https://x.com/ahmet_php',
      'https://github.com/aozisik',
      'https://ahmet.ee',
    ],
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://remotevergi.com/#organization',
    name: 'Remote Vergi',
    url: 'https://remotevergi.com/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://remotevergi.com/icon-512.png',
    },
  },
  datePublished: dateModified ?? '2026-05-07',
  dateModified: dateModified ?? '2026-05-07',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
};

const breadcrumbItems = [
  { name: 'Anasayfa', item: 'https://remotevergi.com/' },
  ...(topic
    ? [
        {
          name: topic.title,
          item: `https://remotevergi.com/rehberler/#${topic.id}`,
        },
      ]
    : []),
  { name: title, item: pageUrl },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.item,
  })),
};

const faqSchema = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: q.answer },
      })),
    }
 : null;

const editUrl = `https://github.com/aozisik/remote-vergi/edit/main/${editPath}`;
const shareTitle = encodeURIComponent(title);
const shareLink = encodeURIComponent(pageUrl);
const twitterUrl = `https://x.com/intent/post?text=${shareTitle}&url=${shareLink}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${shareLink}`;
const whatsappUrl = `https://wa.me/?text=${shareTitle}%20${shareLink}`;
---

<Layout
  title={fullTitle}
  description={description}
  ogType="article"
  ogImage={resolvedOgImage}
  dateModified={dateModified}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
    slot="head"
  />
  {
    faqSchema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
        slot="head"
      />
    )
  }

  <div class="max-w-6xl mx-auto px-5 md:px-8 pt-8 md:pt-12 pb-8">
    <nav
      class="text-[14px] text-slate-600 mb-6 flex flex-wrap items-center gap-x-2 gap-y-1"
      aria-label="Breadcrumbs"
    >
      <a href="/" class="hover:text-brand-700 transition">Anasayfa</a>
      <span class="text-slate-300" aria-hidden="true">/</span>
      {
        topic ? (
          <a
            href={`/rehberler/#${topic.id}`}
            class="hover:text-brand-700 transition"
          >
            {topic.title}
          </a>
        ) : (
          <a href="/rehberler/" class="hover:text-brand-700 transition">
            Rehberler
          </a>
        )
      }
    </nav>

    <div
      class:list={[
        'grid gap-12',
        toc.length > 2 && !wide
          ? 'xl:grid-cols-[minmax(0,1fr)_220px]'
          : '',
      ]}
    >
      <div class:list={['min-w-0', wide ? 'max-w-5xl' : 'max-w-[44rem]']}>
        <div
          data-trust-line
          class="not-prose mt-5 mb-9 flex flex-wrap items-center gap-x-5 gap-y-2 text-[14px] text-slate-600"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg
              viewBox="0 0 24 24"
              class="w-4 h-4 text-gain-600"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12.5l4.2 4.2L19 7"></path>
            </svg>
            Son kontrol: <time datetime={dateModified ?? '2026-05-07'}
              >{verifiedOn}</time
            >
          </span>
          <span>2026 mevzuatına göre</span>
          <a
            href={editUrl}
            target="_blank"
            rel="noopener"
            class="underline decoration-slate-300 underline-offset-4 hover:text-brand-700 hover:decoration-brand-300"
            >Hata mı var? Düzelt</a
          >
          {
            summary && summary.length > 0 && (
              <div class="basis-full mt-5 rounded-2xl bg-white border border-slate-200 p-5 md:p-6">
                <p class="flex items-center gap-2 text-[15px] font-semibold text-slate-900">
                  <svg viewBox="0 0 24 24" class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
                  </svg>
                  Kısaca
                </p>
                <ul class="mt-3 space-y-2.5">
                  {summary.map((line) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed text-slate-800">
                      <span class="mt-[0.6em] w-1.5 h-1.5 rounded-full bg-brand-400 shrink-0" aria-hidden="true" />
                      <span>{line}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <article
          data-pagefind-body
          class:list={[
            'rv-prose prose prose-slate max-w-none',
            wide
              ? '[&>p]:max-w-[44rem] [&>ul]:max-w-[44rem] [&>ol]:max-w-[44rem] [&>blockquote]:max-w-[44rem] [&>h2]:max-w-[44rem] [&>h3]:max-w-[44rem] [&>h4]:max-w-[44rem] [&>table]:max-w-[44rem]'
              : '',
          ]}
        >
          <slot />
        </article>
        <script is:inline>
          // Place the trust line directly under the article's H1 before the
          // first paint, so it reads as the byline.
          (function () {
            var line = document.querySelector('[data-trust-line]');
            var h1 = document.querySelector('.rv-prose > h1');
            if (line && h1) h1.insertAdjacentElement('afterend', line);
          })();
        </script>

        <section
          class="mt-16 rounded-2xl border border-slate-200 bg-white p-6 md:p-7"
          aria-labelledby="about-guide"
        >
          <h2 id="about-guide" class="text-[17px] font-semibold text-slate-900">
            Bu rehber hakkında
          </h2>
          <p class="mt-2 text-[15px] leading-relaxed text-slate-700">
            {verifiedOn} tarihinde 2026 mevzuatına göre kontrol edildi. Rehber
            açık kaynaktır: yanlış ya da eski bir bilgi görürsen
            <a
              href={editUrl}
              target="_blank"
              rel="noopener"
              class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-4 hover:decoration-brand-600"
              >GitHub'da düzeltme önerebilirsin</a
            >. Bilgilendirme amaçlıdır; kendi durumun için mali müşavirine
            danış.
          </p>
          {
            sources && sources.length > 0 && (
              <div class="mt-5">
                <h3 class="text-[14px] font-semibold text-slate-900">Kaynaklar</h3>
                <ul class="mt-2 space-y-1.5 text-[14px]">
                  {sources.map((src) => (
                    <li>
                      <a
                        href={src.url}
                        target="_blank"
                        rel="noopener"
                        class="text-brand-700 underline decoration-brand-200 underline-offset-4 hover:decoration-brand-600"
                      >
                        {src.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <div
            class="mt-5 pt-5 border-t border-slate-100 flex flex-wrap items-center gap-2 text-[13px] text-slate-600"
          >
            <span class="mr-1">Paylaş:</span>
            <a
              href={twitterUrl}
              target="_blank"
              rel="noopener"
              aria-label="X'te paylaş"
              class="share-btn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
            </a>
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noopener"
              aria-label="LinkedIn'de paylaş"
              class="share-btn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
                <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.43zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"></path>
              </svg>
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener"
              aria-label="WhatsApp'ta paylaş"
              class="share-btn"
            >
              WhatsApp
            </a>
            <button
              type="button"
              data-copy-link
              data-url={pageUrl}
              class="share-btn"
            >
              <span data-copy-label>Bağlantıyı kopyala</span>
            </button>
          </div>
        </section>

        {
          related.length > 0 && (
            <section class="mt-14" aria-labelledby="related-guides">
              <h2
                id="related-guides"
                class="text-[22px] font-semibold tracking-[-0.01em] text-slate-900"
              >
                {topic?.title}: diğer rehberler
              </h2>
              <ul class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
                {related.map((g) => (
                  <li>
                    <a
                      href={g.href}
                      class="group flex items-baseline justify-between gap-6 py-4"
                    >
                      <span>
                        <span class="block text-[16px] font-semibold text-slate-900 group-hover:text-brand-700 transition">
                          {g.title}
                        </span>
                        <span class="block mt-0.5 text-[14px] text-slate-600">
                          {g.blurb}
                        </span>
                      </span>
                      <span
                        class="text-slate-400 group-hover:text-brand-600 group-hover:translate-x-0.5 transition"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="mt-14" aria-labelledby="persona-paths">
          <h2
            id="persona-paths"
            class="text-[22px] font-semibold tracking-[-0.01em] text-slate-900"
          >
            Senin durumun hangisi?
          </h2>
          <p class="mt-1.5 text-[15px] text-slate-600">
            Mesleğine göre adım adım yol haritası.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {
              personas.map((p) => (
                <a
                  href={p.href}
                  class="inline-flex items-center h-11 px-4 rounded-full border border-slate-200 bg-white text-[14px] font-medium text-slate-800 hover:border-brand-300 hover:text-brand-700 transition"
                >
                  {p.name}
                </a>
              ))
            }
          </div>
        </section>
      </div>

      {
        toc.length > 2 && !wide && (
          <aside class="hidden xl:block" aria-label="Bu sayfada">
            <div class="sticky top-24">
              <p class="text-[13px] font-semibold text-slate-900 mb-3">
                Bu sayfada
              </p>
              <ol class="space-y-1 border-l border-slate-200" data-toc>
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link={h.slug}
                      class="toc-link block -ml-px pl-3 py-1 border-l border-transparent text-[13px] leading-snug text-slate-600 hover:text-slate-900 transition"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )
      }
    </div>
  </div>

  <style is:global>
    .share-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.25rem;
      height: 2.25rem;
      padding: 0 0.75rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #fff;
      transition: border-color 150ms ease, color 150ms ease;
    }
    .share-btn:hover {
      border-color: oklch(0.85 0.009 25);
      color: var(--ink);
    }

    .toc-link[aria-current='true'] {
      color: var(--brand-deep);
      border-left-color: var(--brand);
      font-weight: 500;
    }
  </style>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.dataset.url ?? window.location.href;
        const label = btn.querySelector<HTMLSpanElement>('[data-copy-label]');
        if (!label) return;
        const original = label.textContent;
        try {
          await navigator.clipboard.writeText(url);
          label.textContent = 'Kopyalandı';
        } catch {
          label.textContent = 'Kopyalanamadı';
        }
        setTimeout(() => {
          label.textContent = original;
        }, 1800);
      });
    });

    // Highlight the section currently in view in the table of contents.
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
      const byId = new Map(
        Array.from(tocLinks).map((a) => [a.dataset.tocLink as string, a])
      );
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            tocLinks.forEach((a) => a.removeAttribute('aria-current'));
            byId.get(entry.target.id)?.setAttribute('aria-current', 'true');
          }
        },
        { rootMargin: '-15% 0px -70% 0px' }
      );
      byId.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }
  </script>
</Layout>
